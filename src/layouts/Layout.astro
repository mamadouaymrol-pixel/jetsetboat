---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title       = "JetSetBoat — Beach & Boat Parties · Côte d'Azur",
  description = "Soirées nautiques exclusives sur la Côte d'Azur. Saint-Tropez, Cannes, Monaco. Réservez votre place.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Google Fonts : Playfair Display + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap"
      rel="stylesheet"
    />

  </head>

  <body>
    <slot />

    <!-- Intersection Observer : fade-up au scroll -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target); // déclenche une seule fois
            }
          });
        },
        { threshold: 0.12 }
      );

      document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
