---
import Layout        from '../layouts/Layout.astro';
import Navbar        from '../components/Navbar.astro';
import Hero          from '../components/Hero.astro';
import Universe      from '../components/Universe.astro';
import Events        from '../components/Events.astro';
import Testimonials  from '../components/Testimonials.astro';
import Ambiance      from '../components/Ambiance.astro';
import Contact       from '../components/Contact.astro';
import InstagramCTA  from '../components/InstagramCTA.astro';
import Footer        from '../components/Footer.astro';
---

<Layout
  title="JetSetBoat — Beach & Boat Parties · Côte d'Azur"
  description="Soirées nautiques exclusives sur la Côte d'Azur. DJ sets, champagne, couchers de soleil en mer. Saint-Tropez, Cannes, Monaco. Réservez votre place."
  ogImage="https://www.jetsetboat.fr/images/og-cover.jpg"
>
  <Navbar />
  <main>
    <Hero />
    <Universe />
    <Events />
    <Testimonials />
    <Ambiance />
    <Contact />
    <InstagramCTA />
  </main>
  <Footer />
</Layout>
