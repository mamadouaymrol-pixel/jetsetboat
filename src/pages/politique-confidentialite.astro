---
import Layout from '../layouts/Layout.astro';
import Navbar  from '../components/Navbar.astro';
import Footer  from '../components/Footer.astro';
---

<Layout
  title="Politique de confidentialité — JetSetBoat"
  description="Politique de confidentialité et protection des données personnelles de JetSetBoat."
>
  <Navbar />

  <main class="legal-page">
    <div class="container legal-container">

      <header class="legal-header">
        <p class="overline">Protection des données</p>
        <h1 class="legal-title">Politique de confidentialité</h1>
        <p class="legal-update">Mise à jour : Mai 2025</p>
      </header>

      <div class="legal-body">

        <section class="legal-section">
          <h2>1. Responsable du traitement</h2>
          <p>
            Mayeul Gallian<br>
            <a href="mailto:contact@jetsetboat.fr">contact@jetsetboat.fr</a><br>
            <a href="tel:+33698925061">+33 6 98 92 50 61</a>
          </p>
        </section>

        <section class="legal-section">
          <h2>2. Données collectées</h2>
          <p>Nom, prénom, email et message via formulaire de contact uniquement.</p>
        </section>

        <section class="legal-section">
          <h2>3. Finalité</h2>
          <p>Répondre aux demandes de contact et de réservation.</p>
        </section>

        <section class="legal-section">
          <h2>4. Durée de conservation</h2>
          <p>3 ans maximum après le dernier contact.</p>
        </section>

        <section class="legal-section">
          <h2>5. Vos droits RGPD</h2>
          <p>
            Droit d'accès, rectification, suppression et opposition.<br>
            Pour exercer vos droits : <a href="mailto:contact@jetsetboat.fr">contact@jetsetboat.fr</a><br>
            Réponse sous 30 jours.
          </p>
        </section>

        <section class="legal-section">
          <h2>6. Sécurité</h2>
          <p>
            Les données sont transmises via protocole HTTPS sécurisé.<br>
            Aucune donnée n'est vendue ou transmise à des tiers.
          </p>
        </section>

        <section class="legal-section">
          <h2>7. Cookies</h2>
          <p>Ce site n'utilise pas de cookies de tracking ou publicitaires.</p>
        </section>

        <section class="legal-section">
          <h2>8. Contact DPO</h2>
          <p>Pour toute question : <a href="mailto:contact@jetsetboat.fr">contact@jetsetboat.fr</a></p>
        </section>

      </div>

      <div class="legal-back">
        <a href="/" class="btn btn-outline">&larr; Retour au site</a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  .legal-page {
    background: #FFF8F3;
    min-height: 100vh;
    padding-top: 72px;
  }

  .legal-container {
    max-width: 760px;
    padding-top: 5rem;
    padding-bottom: 6rem;
  }

  .legal-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .legal-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--dark);
    margin-top: .75rem;
    letter-spacing: -.025em;
    line-height: 1.1;
  }

  .legal-update {
    margin-top: .75rem;
    font-size: .82rem;
    color: var(--grey);
  }

  .legal-body {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .legal-section {
    padding: 1.5rem 0 1.5rem 1.5rem;
    border-left: 3px solid var(--orange);
    border-bottom: 1px solid var(--border);
  }
  .legal-section:first-child { padding-top: 1.5rem; }

  .legal-section h2 {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: .5rem;
    letter-spacing: -.01em;
  }

  .legal-section p {
    font-size: .92rem;
    color: #2D2D2D;
    line-height: 1.8;
  }

  .legal-section a {
    color: var(--orange);
    transition: color var(--transition);
  }
  .legal-section a:hover { color: #e85a24; }

  .legal-back {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>
