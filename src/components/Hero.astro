---
---

<section class="hero" id="hero">

  <!-- Dark overlay so text stays readable -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-content">
    <p class="overline fade-up">Côte d'Azur &nbsp;·&nbsp; Beach &amp; Boat Parties</p>

    <h1 class="hero-title fade-up">
      Plus qu'une soirée&nbsp;—<br>
      <em class="hero-em">une expérience.</em>
    </h1>

    <p class="hero-sub fade-up">
      Rejoignez les soirées nautiques les plus exclusives de la Côte d'Azur.
      Musique live, horizon sans fin et moments inoubliables.
    </p>

    <div class="hero-actions fade-up">
      <a href="#contact"    class="btn btn-primary">Réserver ma place &rarr;</a>
      <a href="#evenements" class="btn btn-outline-white">Voir les événements</a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-hint" aria-hidden="true">
    <span class="scroll-label">Défiler</span>
    <div class="scroll-track"><div class="scroll-cursor"></div></div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 72px;
    overflow: hidden;
    background: url('/images/hero.jpg') center / cover no-repeat;
  }

  /* Dark overlay */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.42);
    z-index: 0;
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  /* Overline: keep orange, visible on dark */
  .overline { margin-bottom: 1.75rem; }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    font-weight: 700;
    line-height: 1.08;
    color: #ffffff;
    margin-bottom: 1.75rem;
    letter-spacing: -.03em;
  }

  .hero-em {
    font-style: italic;
    color: var(--coral);
  }

  .hero-sub {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.8;
    margin-bottom: 2.5rem;
    max-width: 520px;
    padding-left: 1.25rem;
    border-left: 2px solid var(--coral);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* White outline button variant for dark backgrounds */
  .btn-outline-white {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .875rem 2rem;
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: .95rem;
    font-weight: 600;
    cursor: pointer;
    border: 2px solid rgba(255, 255, 255, 0.6);
    color: #ffffff;
    background: transparent;
    white-space: nowrap;
    text-decoration: none;
    transition: background var(--transition), border-color var(--transition), color var(--transition), transform var(--transition);
  }
  .btn-outline-white:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  /* Scroll indicator */
  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .5rem;
    z-index: 1;
  }
  .scroll-label {
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }
  .scroll-track {
    width: 1px;
    height: 44px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }
  .scroll-cursor {
    width: 100%;
    height: 14px;
    background: var(--orange);
    border-radius: 2px;
    animation: scrollDown 2s ease-in-out infinite;
  }
  @keyframes scrollDown {
    0%   { transform: translateY(-14px); opacity: 0; }
    25%  { opacity: 1; }
    75%  { opacity: 1; }
    100% { transform: translateY(44px); opacity: 0; }
  }

  @media (max-width: 600px) {
    .hero-actions { flex-direction: column; }
    .hero-actions .btn,
    .hero-actions .btn-outline-white { text-align: center; justify-content: center; }
    .scroll-hint { display: none; }
  }
</style>
