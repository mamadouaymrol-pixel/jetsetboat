<style>
  .ig-cta {
    background: #0D1117;
    padding: 100px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .ig-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(13,17,23,0.75), rgba(13,17,23,0.75)),
      url('/images/bg-nights.jpg') center / cover no-repeat;
    z-index: 0;
  }

  .ig-cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  /* Instagram icon */
  .ig-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(255,107,53,.15);
    border: 1px solid rgba(255,107,53,.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--orange);
    margin-bottom: .5rem;
  }

  .ig-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -.025em;
    line-height: 1.1;
  }

  .ig-sub {
    font-size: 1rem;
    color: rgba(255,255,255,.62);
    line-height: 1.6;
    max-width: 420px;
  }

  .ig-btn {
    margin-top: .75rem;
    font-size: 1rem;
    padding: 1rem 2.25rem;
    gap: .6rem;
  }

  @media (max-width: 480px) {
    .ig-cta { padding: 72px 0; }
    .ig-btn { width: 100%; justify-content: center; }
  }
</style>
