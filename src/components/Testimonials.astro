---
const testimonials = [
  {
    quote:    "Une soirée absolument magique sur le pont du bateau. Le coucher de soleil, la musique... inoubliable.",
    name:     "Sophie M.",
    city:     "Cannes",
    initials: "SM",
    color:    "#FF6B35",
  },
  {
    quote:    "L'organisation était parfaite, l'ambiance incroyable. On reviendra sans hésiter !",
    name:     "Thomas L.",
    city:     "Paris",
    initials: "TL",
    color:    "#1A3A5C",
  },
  {
    quote:    "JetSetBoat c'est vraiment autre chose. Luxe, bonne humeur et professionnalisme.",
    name:     "Camille R.",
    city:     "Monaco",
    initials: "CR",
    color:    "#F4A261",
  },
];
---

<section class="testimonials">
  <div class="container">

    <div class="testi-header fade-up">
      <p class="overline">Ils nous font confiance</p>
      <h2 class="testi-title">Ce qu'ils en disent</h2>
    </div>

    <div class="testi-grid">
      {testimonials.map((t) => (
        <article class="testi-card fade-up">

          <!-- Stars -->
          <div class="stars" aria-label="5 étoiles sur 5">
            {[1,2,3,4,5].map(() => (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="testi-quote">
            &ldquo;{t.quote}&rdquo;
          </blockquote>

          <!-- Author -->
          <div class="testi-author">
            <div class="testi-avatar" style={`background: ${t.color}`}>
              {t.initials}
            </div>
            <div>
              <p class="testi-name">{t.name}</p>
              <p class="testi-city">{t.city}</p>
            </div>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .testimonials {
    background: #F7F3EE;
    padding: var(--section-py) 0;
    position: relative;
    overflow: hidden;
  }

  /* Faint navy blob bottom-left */
  .testimonials::before {
    content: '';
    position: absolute;
    bottom: -80px;
    left: -80px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(26,58,92,0.03) 0%, transparent 70%);
    pointer-events: none;
  }

  .testi-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .testi-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--dark);
    margin-top: .875rem;
    letter-spacing: -.025em;
    line-height: 1.1;
  }

  /* Grid */
  .testi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* Card */
  .testi-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: var(--shadow-sm);
    transition: transform .35s cubic-bezier(0.34, 1.2, 0.64, 1), box-shadow .3s ease;
  }
  .testi-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
  }

  /* Stars */
  .stars {
    display: flex;
    gap: .2rem;
    color: var(--orange);
  }

  /* Quote */
  .testi-quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1rem;
    color: var(--dark);
    line-height: 1.7;
    flex: 1;
  }

  /* Author */
  .testi-author {
    display: flex;
    align-items: center;
    gap: .875rem;
    padding-top: 1.125rem;
    border-top: 1px solid var(--border);
  }

  .testi-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: .875rem;
    font-weight: 700;
    color: #ffffff;
    flex-shrink: 0;
    letter-spacing: .02em;
  }

  .testi-name {
    font-size: .9rem;
    font-weight: 600;
    color: var(--dark);
    line-height: 1.3;
  }

  .testi-city {
    font-size: .78rem;
    color: var(--grey);
    font-weight: 400;
    margin-top: .1rem;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .testi-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .testi-grid { grid-template-columns: 1fr; }
  }
</style>
