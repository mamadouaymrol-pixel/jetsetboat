---
// Reviews loaded client-side from /reviews.json
---

<section class="testimonials" id="avis">
  <div class="container">

    <div class="testi-header fade-up">
      <p class="overline">Ils nous font confiance</p>
      <h2 class="testi-title">Ce qu'ils en disent</h2>
    </div>

    <div class="carousel-outer fade-up" id="carouselOuter">
      <div class="carousel-track" id="carouselTrack"></div>
    </div>
    <p class="rv-empty-msg" id="noReviews" style="display:none">
      Soyez le premier à partager votre expérience !
    </p>

    <!-- Formulaire inline -->
    <div class="rv-form-wrap fade-up">
      <div class="rv-form-header">
        <p class="overline">Votre expérience</p>
        <h3 class="rv-form-title">Partagez votre avis</h3>
      </div>

      <form id="reviewForm" class="rv-form" novalidate>
        <div class="rv-form-row">
          <div class="rv-field">
            <label for="rf-prenom">Prénom <span class="rv-req">*</span></label>
            <input type="text" id="rf-prenom" name="prenom" required placeholder="Sophie" autocomplete="given-name">
          </div>
          <div class="rv-field">
            <label for="rf-nom">Nom <span class="rv-req">*</span></label>
            <input type="text" id="rf-nom" name="nom" required placeholder="Martin" autocomplete="family-name">
          </div>
        </div>

        <div class="rv-field">
          <label>Note <span class="rv-req">*</span></label>
          <div class="rv-star-picker" id="starPicker" role="group" aria-label="Votre note">
            <button type="button" class="rv-star-btn" data-value="1" aria-label="1 étoile">★</button>
            <button type="button" class="rv-star-btn" data-value="2" aria-label="2 étoiles">★</button>
            <button type="button" class="rv-star-btn" data-value="3" aria-label="3 étoiles">★</button>
            <button type="button" class="rv-star-btn" data-value="4" aria-label="4 étoiles">★</button>
            <button type="button" class="rv-star-btn" data-value="5" aria-label="5 étoiles">★</button>
          </div>
          <input type="hidden" id="rf-rating" name="rating" value="0">
        </div>

        <div class="rv-field">
          <label for="rf-comment">Commentaire <span class="rv-req">*</span></label>
          <textarea id="rf-comment" name="comment" required rows="4" placeholder="Décrivez votre expérience à bord..."></textarea>
        </div>

        <input type="text" name="website" style="display:none" tabindex="-1" aria-hidden="true">

        <div class="rv-form-footer">
          <button type="submit" class="btn btn-primary" id="rfSubmitBtn">Soumettre mon avis</button>
          <p id="rf-feedback" class="rv-feedback" aria-live="polite" style="display:none"></p>
        </div>
      </form>
    </div>

  </div>
</section>

<!-- is:global car les cartes sont injectées par JS et échappent au scoping Astro -->
<style is:global>

  /* ── Section ──────────────────────────────────────────────── */
  .testimonials {
    background: #0D1117;
    padding: var(--section-py) 0;
    position: relative;
    overflow: hidden;
  }
  .testimonials::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(13,17,23,0.88), rgba(13,17,23,0.88)),
      url('/images/bg-testimonials.jpg') center / cover no-repeat;
    z-index: 0;
  }
  .testimonials .container { position: relative; z-index: 1; }

  /* ── Header ───────────────────────────────────────────────── */
  .testi-header { text-align: center; margin-bottom: 3.5rem; }
  .testi-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--dark);
    margin-top: .875rem;
    letter-spacing: -.025em;
    line-height: 1.1;
  }

  /* ── Carousel outer ───────────────────────────────────────── */
  .carousel-outer {
    overflow: hidden;
    margin: 0 -24px;
    margin-bottom: 4rem;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    mask-image:         linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  /* ── Carousel track + animation ───────────────────────────── */
  @keyframes rv-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .carousel-track {
    display: flex;
    width: max-content;
    animation: rv-scroll 36s linear infinite;
  }
  .carousel-outer:hover .carousel-track {
    animation-play-state: paused;
  }

  /* ── Carte avis ───────────────────────────────────────────── */
  .rv-card {
    width: 360px;
    flex-shrink: 0;
    margin-right: 1.5rem;
    background: rgba(0, 0, 0, 0.60);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
  }

  .rv-card-body {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rv-card-stars {
    color: #FF6B35;
    font-size: 1.05rem;
    letter-spacing: .1em;
    line-height: 1;
  }
  .rv-card-stars .rv-star-dim { opacity: .22; }

  .rv-card-comment {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: .9rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.72;
    flex: 1;
  }

  .rv-card-sep {
    height: 1px;
    background: rgba(255, 255, 255, 0.10);
  }

  .rv-card-footer {
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: .75rem;
    background: rgba(0, 0, 0, 0.25);
  }

  .rv-card-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: .75rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .rv-card-name {
    font-size: .875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
  }

  /* ── Aucun avis ───────────────────────────────────────────── */
  .rv-empty-msg {
    text-align: center;
    color: rgba(240, 237, 232, 0.45);
    font-style: italic;
    margin-bottom: 3rem;
  }

  /* ── Formulaire ───────────────────────────────────────────── */
  .rv-form-wrap {
    max-width: 640px;
    margin: 0 auto;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 2px solid rgba(255, 107, 53, 0.35);
    border-radius: 16px;
    padding: 2.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .rv-form-header { margin-bottom: 2rem; }
  .rv-form-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--dark);
    margin-top: .5rem;
  }

  .rv-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .rv-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

  .rv-field { display: flex; flex-direction: column; gap: .375rem; }
  .rv-field label {
    font-size: .78rem;
    font-weight: 700;
    color: rgba(240, 237, 232, 0.6);
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .rv-req { color: #FF6B35; }

  .rv-field input[type="text"],
  .rv-field textarea {
    font-family: var(--font-body);
    font-size: .95rem;
    padding: .75rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1.5px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    color: var(--dark);
    width: 100%;
    transition: border-color .2s, box-shadow .2s;
    resize: vertical;
  }
  .rv-field input[type="text"]::placeholder,
  .rv-field textarea::placeholder { color: rgba(240, 237, 232, 0.25); }
  .rv-field input[type="text"]:focus,
  .rv-field textarea:focus {
    outline: none;
    border-color: #FF6B35;
    box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.15);
  }

  .rv-star-picker { display: flex; gap: .3rem; margin-top: .2rem; }
  .rv-star-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 2rem;
    color: rgba(255, 107, 53, 0.2);
    padding: 0 .05rem;
    line-height: 1;
    transition: color .15s, transform .15s;
  }
  .rv-star-btn:hover,
  .rv-star-btn.active { color: #FF6B35; transform: scale(1.2); }

  .rv-form-footer { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; margin-top: .25rem; }

  .rv-feedback { font-size: .9rem; font-weight: 500; flex: 1; }
  .rv-feedback.ok  { color: #4ade80; }
  .rv-feedback.err { color: #f87171; }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 600px) {
    .rv-form-row { grid-template-columns: 1fr; }
    .rv-form-wrap { padding: 1.5rem 1.25rem; }
    .rv-card { width: min(300px, 82vw); }
    .carousel-outer { margin: 0 -12px; margin-bottom: 3rem; }
  }

</style>

<script>
(function () {
  'use strict';

  const COLORS = ['#FF6B35', '#1A3A5C', '#F4A261', '#2E7D6B', '#7B3FAB'];

  function esc(s) {
    const d = document.createElement('div');
    d.textContent = String(s ?? '');
    return d.innerHTML;
  }

  /* ── Construit une carte ──────────────────────────────────── */
  function buildCard(review, idx) {
    const color    = COLORS[idx % COLORS.length];
    const initials = ((review.firstName[0] ?? '') + (review.lastName[0] ?? '')).toUpperCase();
    const name     = `${esc(review.firstName)} ${esc(review.lastName[0])}.`;
    const filled   = '★'.repeat(Math.max(0, review.rating));
    const empty    = review.rating < 5
      ? `<span class="rv-star-dim">${'★'.repeat(5 - review.rating)}</span>`
      : '';

    const card = document.createElement('article');
    card.className = 'rv-card';
    card.innerHTML = `
      <div class="rv-card-body">
        <div class="rv-card-stars" aria-label="${review.rating} étoile${review.rating > 1 ? 's' : ''} sur 5">
          ${filled}${empty}
        </div>
        <blockquote class="rv-card-comment">${esc(review.comment)}</blockquote>
      </div>
      <div class="rv-card-sep"></div>
      <div class="rv-card-footer">
        <div class="rv-card-avatar" style="background:${color}">${initials}</div>
        <span class="rv-card-name">${name}</span>
      </div>`;
    return card;
  }

  /* ── Carrousel ────────────────────────────────────────────── */
  async function initCarousel() {
    const track  = document.getElementById('carouselTrack');
    const outer  = document.getElementById('carouselOuter');
    const noRevs = document.getElementById('noReviews');
    if (!track || !outer) return;

    let approved = [];
    try {
      const res = await fetch('/reviews.json');
      if (res.ok) {
        const all = await res.json();
        approved = all.filter(r => r.status === 'approved');
      }
    } catch (_) {}

    if (approved.length === 0) {
      outer.style.display = 'none';
      if (noRevs) noRevs.style.display = '';
      return;
    }

    // Injecte les cartes + leur clone pour la boucle CSS (-50%)
    const fragment = document.createDocumentFragment();
    const clone    = document.createDocumentFragment();
    approved.forEach((r, i) => {
      fragment.appendChild(buildCard(r, i));
      clone.appendChild(buildCard(r, i));
    });
    track.appendChild(fragment);
    track.appendChild(clone);
  }

  /* ── Sélecteur d'étoiles ──────────────────────────────────── */
  function initStars() {
    const picker = document.getElementById('starPicker');
    const input  = document.getElementById('rf-rating');
    if (!picker) return;

    const btns = [...picker.querySelectorAll('.rv-star-btn')];
    let current = 0;
    const hl = n => btns.forEach((b, i) => b.classList.toggle('active', i < n));

    btns.forEach((btn, i) => {
      btn.addEventListener('mouseenter', () => hl(i + 1));
      btn.addEventListener('mouseleave', () => hl(current));
      btn.addEventListener('click', () => { current = i + 1; input.value = current; hl(current); });
    });
  }

  /* ── Formulaire ───────────────────────────────────────────── */
  function initForm() {
    const form      = document.getElementById('reviewForm');
    const feedback  = document.getElementById('rf-feedback');
    const submitBtn = document.getElementById('rfSubmitBtn');
    if (!form) return;

    const show = (msg, ok) => {
      feedback.textContent   = msg;
      feedback.className     = 'rv-feedback ' + (ok ? 'ok' : 'err');
      feedback.style.display = '';
    };

    form.addEventListener('submit', async e => {
      e.preventDefault();
      if (parseInt(document.getElementById('rf-rating').value || '0') < 1) {
        show('Veuillez sélectionner une note.', false);
        return;
      }
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi…';

      const base = (location.hostname === 'localhost' || location.hostname === '127.0.0.1')
        ? 'http://localhost:8080' : '';

      try {
        const res  = await fetch(`${base}/submit-review.php`, { method: 'POST', body: new FormData(form) });
        const json = await res.json();
        if (json.ok) {
          show('Merci ! Votre avis sera publié après validation.', true);
          form.reset();
          document.getElementById('rf-rating').value = '0';
          document.querySelectorAll('.rv-star-btn').forEach(b => b.classList.remove('active'));
        } else {
          show(json.error || 'Une erreur est survenue.', false);
        }
      } catch (_) {
        show('Impossible de soumettre. Vérifiez votre connexion.', false);
      } finally {
        submitBtn.disabled    = false;
        submitBtn.textContent = 'Soumettre mon avis';
      }
    });
  }

  initCarousel();
  initStars();
  initForm();
})();
</script>
