---
const testimonials = [
  {
    quote:    "Une soirée absolument magique sur le pont du bateau. Le coucher de soleil, la musique... inoubliable.",
    name:     "Sophie M.",
    city:     "Cannes",
    initials: "SM",
    color:    "#FF6B35",
  },
  {
    quote:    "L'organisation était parfaite, l'ambiance incroyable. On reviendra sans hésiter !",
    name:     "Thomas L.",
    city:     "Paris",
    initials: "TL",
    color:    "#1A3A5C",
  },
  {
    quote:    "JetSetBoat c'est vraiment autre chose. Luxe, bonne humeur et professionnalisme.",
    name:     "Camille R.",
    city:     "Monaco",
    initials: "CR",
    color:    "#F4A261",
  },
];
---

<section class="testimonials">
  <div class="container">

    <div class="testi-header fade-up">
      <p class="overline">Ils nous font confiance</p>
      <h2 class="testi-title">Ce qu'ils en disent</h2>
    </div>

    <div class="testi-grid">
      {testimonials.map((t) => (
        <article class="testi-card fade-up">

          <!-- Decorative quote mark -->
          <div class="testi-deco" aria-hidden="true">&ldquo;</div>

          <!-- Stars -->
          <div class="stars" aria-label="5 étoiles sur 5">
            {[1,2,3,4,5].map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="testi-quote">
            {t.quote}
          </blockquote>

          <!-- Author -->
          <div class="testi-author">
            <div class="testi-avatar" style={`background: ${t.color}`}>
              {t.initials}
            </div>
            <div>
              <p class="testi-name">{t.name}</p>
              <p class="testi-city">{t.city}</p>
            </div>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .testimonials {
    background: #0D1117;
    padding: var(--section-py) 0;
    position: relative;
    overflow: hidden;
  }

  /* Faint orange blob bottom-left */
  .testimonials::before {
    content: '';
    position: absolute;
    bottom: -80px;
    left: -80px;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,107,53,0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .testi-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .testi-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--dark);
    margin-top: .875rem;
    letter-spacing: -.025em;
    line-height: 1.1;
  }

  /* Grid */
  .testi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* Card */
  .testi-card {
    background: #1A2332;
    border: 1px solid rgba(255,255,255,0.08);
    border-top: 2px solid rgba(255,107,53,.18);
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    transition: transform .35s cubic-bezier(0.34, 1.2, 0.64, 1), box-shadow .3s ease, border-color .3s ease;
    position: relative;
  }
  .testi-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 56px rgba(0,0,0,.5), 0 4px 16px rgba(255,107,53,.12);
    border-top-color: rgba(255,107,53,.45);
  }

  /* Decorative large quote mark */
  .testi-deco {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    font-family: var(--font-heading);
    font-size: 4rem;
    line-height: 1;
    color: rgba(255,107,53,.12);
    pointer-events: none;
    user-select: none;
  }

  /* Stars */
  .stars {
    display: flex;
    gap: .2rem;
    color: var(--orange);
  }

  /* Quote */
  .testi-quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: .975rem;
    color: rgba(240,237,232,.88);
    line-height: 1.75;
    flex: 1;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255,255,255,.07);
  }

  /* Author */
  .testi-author {
    display: flex;
    align-items: center;
    gap: .875rem;
    padding-top: .25rem;
  }

  .testi-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: .875rem;
    font-weight: 700;
    color: #ffffff;
    flex-shrink: 0;
    letter-spacing: .02em;
    box-shadow: 0 2px 8px rgba(0,0,0,.35);
  }

  .testi-name {
    font-size: .9rem;
    font-weight: 600;
    color: var(--dark);
    line-height: 1.3;
  }

  .testi-city {
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    background: linear-gradient(90deg, var(--orange) 0%, var(--coral) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-top: .15rem;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .testi-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .testi-grid { grid-template-columns: 1fr; }
  }
</style>
