---
---

<section class="events" id="evenements">
  <div class="container">

    <div class="events-header fade-up">
      <p class="overline">Prochains événements</p>
      <h2 class="events-title">Choisissez<br>votre soirée</h2>
      <p class="events-sub">Chaque événement est une invitation à vivre autrement. Nombre de places limité, ambiance soignée, décor naturel exceptionnel — réservez avant qu'il ne soit trop tard.</p>
    </div>

    <div class="cards-grid" id="events-grid">
      <div class="events-loading">
        <span class="ld"></span><span class="ld"></span><span class="ld"></span>
      </div>
    </div>

  </div>
</section>

<style>
  .events {
    background: #111820;
    position: relative;
    overflow: hidden;
  }

  .events::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(13,17,23,0.88), rgba(13,17,23,0.88)),
      url('/images/bg-events.jpg') center / cover no-repeat;
    z-index: 0;
  }

  .events .container {
    position: relative;
    z-index: 1;
  }

  .events-header {
    text-align: center;
    margin-bottom: 4rem;
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
  }

  .events-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 700;
    color: var(--dark);
    margin-top: .875rem;
    margin-bottom: 1rem;
    letter-spacing: -.03em;
    line-height: 1.08;
  }

  .events-sub {
    font-size: .95rem;
    color: var(--grey);
    line-height: 1.7;
  }

  /* Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  /* Loading dots */
  .events-loading {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: .5rem;
    padding: 4rem 0;
  }
  .ld {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,.25);
    animation: dotPulse 1.2s ease-in-out infinite;
  }
  .ld:nth-child(2) { animation-delay: .2s; }
  .ld:nth-child(3) { animation-delay: .4s; }
  @keyframes dotPulse {
    0%, 80%, 100% { opacity: .25; transform: scale(1); }
    40%           { opacity: 1;   transform: scale(1.3); }
  }

  .events-empty, .events-error {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
    color: var(--grey);
    font-size: .95rem;
  }

  /* Card */
  .card {
    background: #1A2332;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    transition:
      transform  .4s cubic-bezier(0.34, 1.2, 0.64, 1),
      box-shadow .35s ease;
  }
  .card:hover {
    transform: translateY(-8px);
    box-shadow:
      0 24px 56px rgba(0,0,0,.5),
      0 4px 16px rgba(255,107,53,.12);
  }

  .card--featured {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0,0,0,.5);
    border-color: rgba(255,107,53,.2);
  }
  .card--featured:hover {
    transform: translateY(-12px);
    box-shadow:
      0 32px 72px rgba(0,0,0,.6),
      0 4px 20px rgba(255,107,53,.15);
  }

  /* Card link wrapper */
  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  /* Stripe header */
  .card-stripe {
    position: relative;
    padding: 1.5rem 1.5rem 1.25rem;
    overflow: hidden;
    min-height: 96px;
    display: flex;
    align-items: flex-end;
    background-size: cover;
    background-position: center;
  }

  .card-stripe::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(26,58,92,0.72) 0%, rgba(13,17,23,0.88) 100%);
    z-index: 0;
  }

  .card-watermark {
    position: absolute;
    bottom: -12px;
    left: -4px;
    font-family: var(--font-heading);
    font-size: 5.5rem;
    font-weight: 700;
    line-height: 1;
    color: rgba(255,255,255,.13);
    pointer-events: none;
    user-select: none;
    z-index: 1;
  }

  .card-stripe-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .card-date {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: rgba(255,255,255,.92);
    letter-spacing: -.01em;
  }

  /* Body */
  .card-body {
    padding: 1.5rem 1.5rem 1rem;
    flex: 1;
  }

  .card-name {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: .4rem;
    letter-spacing: -.015em;
    line-height: 1.2;
  }

  .card-location {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-size: .75rem;
    font-weight: 700;
    color: var(--grey);
    margin-bottom: .875rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .card-location svg { color: var(--orange); flex-shrink: 0; }

  .card-desc {
    font-size: .875rem;
    color: var(--grey);
    line-height: 1.72;
  }

  /* Footer */
  .card-footer {
    padding: 1.125rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(255,255,255,.07);
    background: rgba(0,0,0,.15);
  }

  .card-price-wrap {
    display: flex;
    flex-direction: column;
    gap: .05rem;
  }

  .card-price-label {
    font-size: .68rem;
    color: var(--grey);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .card-price-row {
    display: flex;
    align-items: baseline;
    gap: .05rem;
    line-height: 1;
  }

  .card-price {
    font-family: var(--font-heading);
    font-size: 2.1rem;
    font-weight: 700;
    color: var(--orange);
    line-height: 1;
  }

  .card-currency {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--orange);
    margin-left: .05rem;
  }

  .card-btn {
    padding: .6rem 1.375rem;
    font-size: .825rem;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .cards-grid { grid-template-columns: 1fr 1fr; }
    .card--featured { transform: none; }
    .card--featured:hover { transform: translateY(-8px); }
  }
  @media (max-width: 600px) {
    .cards-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  function escH(s: string): string {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
  function escA(s: string): string {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
  function safeUrl(url: string): string {
    return /^https?:\/\//.test(url) ? url : '#';
  }

  async function loadEvents(): Promise<void> {
    const grid = document.getElementById('events-grid');
    if (!grid) return;

    try {
      const res = await fetch('/events.json');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const events: any[] = await res.json();

      events.sort((a, b) => String(a.date).localeCompare(String(b.date)));

      if (!events.length) {
        grid.innerHTML = '<p class="events-empty">Aucun événement à venir pour le moment.</p>';
        return;
      }

      grid.innerHTML = events.map((ev, i) => {
        const date  = new Date(ev.date + 'T12:00:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' });
        const feat  = ev.featured ? ' card--featured' : '';
        const num   = String(i + 1).padStart(2, '0');
        const delay = (i * 0.12).toFixed(2);
        const href  = safeUrl(ev.stripeLink);
        const img   = escA(ev.image || '');

        return `
<article class="card fade-up${escH(feat)}" style="transition-delay:${delay}s">
  <a href="${escA(href)}" target="_blank" rel="noopener noreferrer" class="card-link">
    <div class="card-stripe" style="background-image:url('${img.replace(/'/g,"%27")}')">
      <span class="card-watermark" aria-hidden="true">${escH(num)}</span>
      <div class="card-stripe-inner">
        <span class="card-date">${escH(date)}</span>
      </div>
    </div>
    <div class="card-body">
      <h3 class="card-name">${escH(ev.title)}</h3>
      <p class="card-location">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
        ${escH(ev.location)}
      </p>
      <p class="card-desc">${escH(ev.description)}</p>
    </div>
    <div class="card-footer">
      <div class="card-price-wrap">
        <span class="card-price-label">À partir de</span>
        <p class="card-price-row">
          <span class="card-price">${escH(String(ev.price))}</span>
          <span class="card-currency">€</span>
        </p>
      </div>
      <span class="btn btn-primary card-btn">Réserver →</span>
    </div>
  </a>
</article>`;
      }).join('');

      // Observe newly injected cards for fade-up animation
      const io = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.10 });

      grid.querySelectorAll('.fade-up').forEach(el => io.observe(el));

    } catch {
      if (grid) grid.innerHTML = '<p class="events-error">Impossible de charger les événements.</p>';
    }
  }

  loadEvents();
</script>
