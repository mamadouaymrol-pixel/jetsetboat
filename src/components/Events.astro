---
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const events = allEvents.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

function formatDate(date: Date): string {
  return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' });
}
---

<section class="events" id="evenements">
  <div class="container">

    <div class="events-header fade-up">
      <p class="overline">Prochains événements</p>
      <h2 class="events-title">Choisissez<br>votre soirée</h2>
      <p class="events-sub">Chaque événement est une invitation à vivre autrement. Nombre de places limité, ambiance soignée, décor naturel exceptionnel — réservez avant qu'il ne soit trop tard.</p>
    </div>

    <div class="cards-grid">
      {events.map((ev, i) => (
        <article class={`card fade-up${ev.data.featured ? ' card--featured' : ''}`}>

          <div class="card-stripe" style={`background-image: url('${ev.data.image}')`}>
            <span class="card-watermark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="card-stripe-inner">
              <span class="card-date">{formatDate(ev.data.date)}</span>
            </div>
          </div>

          <div class="card-body">
            <h3 class="card-name">{ev.data.title}</h3>
            <p class="card-location">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              {ev.data.location}
            </p>
            <p class="card-desc">{ev.data.description}</p>
          </div>

          <div class="card-footer">
            <div class="card-price-wrap">
              <span class="card-price-label">À partir de</span>
              <p class="card-price-row">
                <span class="card-price">{ev.data.price}</span>
                <span class="card-currency">€</span>
              </p>
            </div>
            <a href="#contact" class="btn btn-primary card-btn">Réserver →</a>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .events {
    background: #111820;
    position: relative;
    overflow: hidden;
  }

  .events::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(13,17,23,0.88), rgba(13,17,23,0.88)),
      url('/images/bg-events.jpg') center / cover no-repeat;
    z-index: 0;
  }

  .events .container {
    position: relative;
    z-index: 1;
  }

  .events-header {
    text-align: center;
    margin-bottom: 4rem;
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
  }

  .events-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 700;
    color: var(--dark);
    margin-top: .875rem;
    margin-bottom: 1rem;
    letter-spacing: -.03em;
    line-height: 1.08;
  }

  .events-sub {
    font-size: .95rem;
    color: var(--grey);
    line-height: 1.7;
  }

  /* Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  /* Card */
  .card {
    background: #1A2332;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    transition:
      transform  .4s cubic-bezier(0.34, 1.2, 0.64, 1),
      box-shadow .35s ease;
  }
  .card:hover {
    transform: translateY(-8px);
    box-shadow:
      0 24px 56px rgba(0,0,0,.5),
      0 4px 16px rgba(255,107,53,.12);
  }

  .card--featured {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0,0,0,.5);
    border-color: rgba(255,107,53,.2);
  }
  .card--featured:hover {
    transform: translateY(-12px);
    box-shadow:
      0 32px 72px rgba(0,0,0,.6),
      0 4px 20px rgba(255,107,53,.15);
  }

  /* Stripe header */
  .card-stripe {
    position: relative;
    padding: 1.5rem 1.5rem 1.25rem;
    overflow: hidden;
    min-height: 96px;
    display: flex;
    align-items: flex-end;
    background-size: cover;
    background-position: center;
  }

  .card-stripe::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(26,58,92,0.72) 0%, rgba(13,17,23,0.88) 100%);
    z-index: 0;
  }

  .card-watermark {
    position: absolute;
    bottom: -12px;
    left: -4px;
    font-family: var(--font-heading);
    font-size: 5.5rem;
    font-weight: 700;
    line-height: 1;
    color: rgba(255,255,255,.13);
    pointer-events: none;
    user-select: none;
    z-index: 1;
  }

  .card-stripe-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .card-date {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: rgba(255,255,255,.92);
    letter-spacing: -.01em;
  }

  /* Body */
  .card-body {
    padding: 1.5rem 1.5rem 1rem;
    flex: 1;
  }

  .card-name {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: .4rem;
    letter-spacing: -.015em;
    line-height: 1.2;
  }

  .card-location {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-size: .75rem;
    font-weight: 700;
    color: var(--grey);
    margin-bottom: .875rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .card-location svg { color: var(--orange); flex-shrink: 0; }

  .card-desc {
    font-size: .875rem;
    color: var(--grey);
    line-height: 1.72;
  }

  /* Footer */
  .card-footer {
    padding: 1.125rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(255,255,255,.07);
    background: rgba(0,0,0,.15);
  }

  .card-price-wrap {
    display: flex;
    flex-direction: column;
    gap: .05rem;
  }

  .card-price-label {
    font-size: .68rem;
    color: var(--grey);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .card-price-row {
    display: flex;
    align-items: baseline;
    gap: .05rem;
    line-height: 1;
  }

  .card-price {
    font-family: var(--font-heading);
    font-size: 2.1rem;
    font-weight: 700;
    color: var(--orange);
    line-height: 1;
  }

  .card-currency {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--orange);
    margin-left: .05rem;
  }

  .card-btn {
    padding: .6rem 1.375rem;
    font-size: .825rem;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .cards-grid { grid-template-columns: 1fr 1fr; }
    .card--featured { transform: none; }
    .card--featured:hover { transform: translateY(-8px); }
  }
  @media (max-width: 600px) {
    .cards-grid { grid-template-columns: 1fr; }
  }
</style>
