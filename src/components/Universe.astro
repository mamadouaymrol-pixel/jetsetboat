---
const pillars = [
  {
    img:   "/images/univers-1.jpg",
    title: "Exclusivité",
    text:  "Chaque soirée est limitée à un nombre restreint d'invités pour garantir une atmosphère intimiste et soignée.",
  },
  {
    img:   "/images/univers-2.jpg",
    title: "Instants uniques",
    text:  "Couchers de soleil sur mer, DJs live, champagne — chaque détail est orchestré pour marquer les esprits.",
  },
  {
    img:   "/images/univers-3.jpg",
    title: "Cadre naturel",
    text:  "Saint-Tropez, Monaco, Cannes — les plus beaux spots de la Côte d'Azur comme décor de vos soirées.",
  },
];
---

<section class="universe">
  <div class="container">

    <div class="universe-header fade-up">
      <p class="overline">Notre univers</p>
      <h2 class="universe-title">
        L'art de célébrer<br>
        <em>en pleine mer.</em>
      </h2>
      <p class="universe-sub">
        JetSetBoat réinvente la fête en la portant là où elle devrait toujours être — sur l'eau,
        sous le soleil, loin de l'ordinaire.
      </p>
    </div>

    <div class="universe-grid">
      {pillars.map((p) => (
        <div class="pillar fade-up">
          <img class="pillar-img" src={p.img} alt="" aria-hidden="true" />
          <h3 class="pillar-title">{p.title}</h3>
          <p class="pillar-text">{p.text}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .universe {
    background: #0D1117;
    padding: 140px 0;
    position: relative;
    overflow: hidden;
  }

  .universe::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(13,17,23,0.85), rgba(13,17,23,0.85)),
      url('/images/bg-univers.jpg') center / cover no-repeat;
    z-index: 0;
  }

  .universe .container {
    position: relative;
    z-index: 1;
  }

  /* Header */
  .universe-header {
    text-align: center;
    margin-bottom: 5rem;
    max-width: 620px;
    margin-left: auto;
    margin-right: auto;
  }

  .universe-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    color: var(--dark);
    margin-top: .875rem;
    margin-bottom: 1.25rem;
    letter-spacing: -.03em;
    line-height: 1.08;
  }

  .universe-title em {
    font-style: italic;
    color: var(--orange);
  }

  .universe-sub {
    font-size: 1rem;
    color: var(--grey);
    line-height: 1.8;
    max-width: 520px;
    margin: 0 auto;
  }

  /* Grid */
  .universe-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  /* Pillar card */
  .pillar {
    background: var(--white);
    border: 1px solid var(--border);
    border-top: 2px solid rgba(255,107,53,.15);
    border-radius: var(--radius);
    padding: 2.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
    transition: transform .4s cubic-bezier(0.34, 1.2, 0.64, 1), box-shadow .35s ease, border-color .3s ease;
    box-shadow: var(--shadow-sm);
  }
  .pillar:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-top-color: rgba(255,107,53,.45);
  }

  /* Round pillar image */
  .pillar-img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid rgba(255,107,53,.25);
    box-shadow: 0 4px 16px rgba(0,0,0,.4);
    transition: transform var(--transition-spring), border-color var(--transition);
  }
  .pillar:hover .pillar-img {
    transform: scale(1.08);
    border-color: rgba(255,107,53,.55);
  }

  .pillar-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--dark);
    letter-spacing: -.015em;
  }

  .pillar-text {
    font-size: .9rem;
    color: var(--grey);
    line-height: 1.72;
  }

  /* Responsive */
  @media (max-width: 860px) {
    .universe-grid { grid-template-columns: 1fr 1fr; }
    .universe { padding: 100px 0; }
  }
  @media (max-width: 540px) {
    .universe-grid { grid-template-columns: 1fr; }
    .universe { padding: 72px 0; }
  }
</style>
