  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-legal">SIRET 914 085 691 00014</p>
      <nav class="footer-bottom-links" aria-label="Liens légaux">
        <a href="/mentions-legales"          class="footer-bottom-link">Mentions légales</a>
        <span class="footer-bottom-sep" aria-hidden="true">&middot;</span>
        <a href="/politique-confidentialite" class="footer-bottom-link">Politique de confidentialité</a>
        <span class="footer-bottom-sep" aria-hidden="true">&middot;</span>
        <a href="/cgv"                       class="footer-bottom-link">CGV</a>
      </nav>
      <p class="footer-legal">&copy; 2025 JetSetBoat &mdash; Tous droits réservés</p>
    </div>
  </div>

</footer>

<style>
  .footer {
    background: #060A10;
    color: rgba(255,255,255,.7);
    padding: 4.5rem 0 0;
    position: relative;
    overflow: hidden;
  }

  /* Orange top glow */
  .footer-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(255,107,53,.65) 50%, transparent 100%);
  }
  .footer-glow::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 240px;
    height: 72px;
    background: radial-gradient(ellipse at top, rgba(255,107,53,.14) 0%, transparent 70%);
  }

  /* Grid */
  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 3.5rem;
    padding-bottom: 3.5rem;
  }

  /* Brand */
  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: #F0EDE8;
    display: block;
    margin-bottom: .75rem;
    letter-spacing: -.025em;
  }
  .logo-boat {
    font-style: italic;
    color: var(--orange);
  }

  .footer-tagline {
    font-size: .85rem;
    color: rgba(255,255,255,.38);
    letter-spacing: .03em;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .footer-social {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    font-size: .82rem;
    font-weight: 500;
    color: rgba(255,255,255,.55);
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 50px;
    padding: .5rem 1rem .5rem .875rem;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }
  .footer-social:hover {
    background: rgba(255,107,53,.14);
    color: var(--orange);
    border-color: rgba(255,107,53,.28);
  }

  /* Column */
  .footer-col-title {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(255,255,255,.3);
    margin-bottom: 1.25rem;
  }

  .footer-nav,
  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }

  .footer-link {
    font-size: .875rem;
    color: rgba(255,255,255,.5);
    transition: color var(--transition);
    line-height: 1.4;
  }
  .footer-link:hover { color: rgba(255,255,255,.9); }
  .footer-loc { cursor: default; }
  .footer-loc:hover { color: rgba(255,255,255,.5); }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,.07);
    padding: 1.375rem 0;
  }
  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .footer-legal {
    font-size: .74rem;
    color: rgba(255,255,255,.28);
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-bottom-link {
    font-size: .74rem;
    color: rgba(255,255,255,.38);
    transition: color var(--transition);
  }
  .footer-bottom-link:hover { color: rgba(255,255,255,.75); }

  .footer-bottom-sep {
    font-size: .74rem;
    color: rgba(255,255,255,.2);
  }

  /* Responsive */
  @media (max-width: 860px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .footer-inner { grid-template-columns: 1fr; gap: 2.25rem; }
    .footer-bottom-inner { flex-direction: column; gap: .5rem; text-align: center; }
  }
</style>
