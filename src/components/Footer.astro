    <!-- Navigation -->
    <div class="footer-col">
      <h4 class="footer-col-title">Navigation</h4>
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="#evenements" class="footer-link">Événements</a>
        <a href="#contact"    class="footer-link">Contact &amp; Réservation</a>
        <a href="https://www.instagram.com/jetsetboat/" target="_blank" rel="noopener" class="footer-link">Instagram</a>
      </nav>
    </div>

    <!-- Contact -->
    <div class="footer-col">
      <h4 class="footer-col-title">Nous contacter</h4>
      <div class="footer-contact-list">
        <a href="mailto:Mayeulg@yahoo.fr" class="footer-link">Mayeulg@yahoo.fr</a>
        <a href="tel:+33698925061"             class="footer-link">+33 6 98 92 50 61</a>
