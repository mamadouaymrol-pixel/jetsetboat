---
// In dev, the form POSTs to XAMPP on port 8080; in production, same origin.
const contactUrl = import.meta.env.DEV
  ? 'http://localhost:8080/contact.php'
  : '/contact.php';
---

<section class="contact" id="contact">
  <div class="container contact-inner">

    <!-- Left info panel -->
    <div class="contact-info fade-up">
      <p class="overline">Sur-mesure</p>
      <h2 class="contact-title">
        Une demande<br>
        <em>sur-mesure ?</em>
      </h2>
      <p class="contact-sub">
        Soirée privée, séminaire, anniversaire VIP ou simple question —
        notre équipe vous répond sous 24h.
      </p>

      <ul class="contact-details">
        <li class="contact-item">
          <div class="contact-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div>
            <span class="contact-item-label">Email</span>
            <a href="mailto:contact@jetsetboat.fr" class="contact-item-val">contact@jetsetboat.fr</a>
          </div>
        </li>

        <li class="contact-item">
          <div class="contact-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.12 1.18 2 2 0 012.11 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.09a16 16 0 006 6l.45-.45a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
            </svg>
          </div>
          <div>
            <span class="contact-item-label">Téléphone</span>
            <a href="tel:+33698925061" class="contact-item-val">+33 6 98 92 50 61</a>
          </div>
        </li>

        <li class="contact-item">
          <div class="contact-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </div>
          <div>
            <span class="contact-item-label">Instagram</span>
            <a href="https://www.instagram.com/jetsetboat/" target="_blank" rel="noopener" class="contact-item-val">@jetsetboat</a>
          </div>
        </li>
      </ul>

      <!-- Response time badge -->
      <div class="response-badge">
        <span class="response-dot" aria-hidden="true"></span>
        Réponse garantie sous 24h
      </div>
    </div>

    <!-- Form card -->
    <div class="form-card fade-up">
      <form class="contact-form" id="contactForm" action={contactUrl} method="POST" novalidate>

        <!-- Honeypot anti-spam (hidden) -->
        <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off">

        <div class="form-row">
          <div class="form-group">
            <label for="prenom">Prénom</label>
            <input type="text" id="prenom" name="prenom" placeholder="Jean" required>
          </div>
          <div class="form-group">
            <label for="nom">Nom</label>
            <input type="text" id="nom" name="nom" placeholder="Dupont" required>
          </div>
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="jean@exemple.fr" required>
        </div>

        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" placeholder="Décrivez votre demande..." required></textarea>
        </div>

        <div class="form-error" id="formError" aria-live="polite"></div>

        <button type="submit" class="btn btn-primary submit-btn" id="submitBtn">
          Envoyer ma demande &rarr;
        </button>
      </form>

      <div class="form-success" id="formSuccess" hidden>
        <div class="success-icon" aria-hidden="true">✓</div>
        <h3>Message envoyé !</h3>
        <p>Merci, nous vous répondons sous 24h.</p>
      </div>
    </div>

  </div>
</section>

<style>
  .contact {
    background: var(--white);
    position: relative;
    overflow: hidden;
  }

  /* Background image */
  .contact::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/contact-bg.jpg') center / cover no-repeat;
    opacity: 0.5;
    pointer-events: none;
    z-index: 0;
  }

  /* Dark softening overlay */
  .contact::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    pointer-events: none;
    z-index: 0;
  }

  /* Lift all content above both pseudo-elements */
  .contact-inner { position: relative; z-index: 1; }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 5rem;
    align-items: start;
  }

  /* Left */
  .contact-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--dark);
    margin-top: .875rem;
    margin-bottom: 1.25rem;
    line-height: 1.1;
    letter-spacing: -.03em;
  }
  .contact-title em {
    font-style: italic;
    color: var(--orange);
  }

  .contact-sub {
    color: var(--grey);
    font-size: .95rem;
    line-height: 1.75;
    margin-bottom: 2.5rem;
    max-width: 360px;
  }

  .contact-details {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
    margin-bottom: 2.25rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .contact-icon {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: rgba(255,107,53,.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--orange);
    flex-shrink: 0;
    transition: background var(--transition), transform var(--transition-spring);
  }
  .contact-item:hover .contact-icon {
    background: rgba(255,107,53,.14);
    transform: scale(1.06);
  }

  .contact-item-label {
    display: block;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--grey);
    margin-bottom: .2rem;
  }

  .contact-item-val {
    font-size: .9rem;
    font-weight: 500;
    color: var(--dark);
    transition: color var(--transition);
  }
  .contact-item-val:hover { color: var(--orange); }

  /* Response badge */
  .response-badge {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    padding: .65rem 1.1rem;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 50px;
    font-size: .8rem;
    font-weight: 500;
    color: rgba(255,255,255,.85);
  }

  .response-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(34,197,94,.2);
    animation: pulseDot 2.2s ease-in-out infinite;
  }
  @keyframes pulseDot {
    0%, 100% { box-shadow: 0 0 0 3px rgba(34,197,94,.2); }
    50%       { box-shadow: 0 0 0 7px rgba(34,197,94,.07); }
  }

  /* Form card */
  .form-card {
    background: rgba(26, 35, 50, 0.95);
    border: 1px solid rgba(255,255,255,.10);
    border-radius: var(--radius);
    padding: 2.5rem;
    box-shadow: 0 8px 40px rgba(0,0,0,.5);
    backdrop-filter: blur(12px);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: .4rem;
  }

  label {
    font-size: .78rem;
    font-weight: 700;
    color: rgba(255,255,255,.6);
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  input, textarea {
    font-family: var(--font-body);
    font-size: .95rem;
    color: #F0EDE8;
    background: #0D1117;
    border: 1.5px solid rgba(255,255,255,.12);
    border-radius: var(--radius-sm);
    padding: .8rem 1rem;
    transition: border-color .25s ease, box-shadow .25s ease;
    resize: vertical;
    width: 100%;
  }

  input::placeholder, textarea::placeholder { color: rgba(255,255,255,.35); }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--orange);
    box-shadow: 0 0 0 4px rgba(255,107,53,.15);
  }

  .submit-btn {
    width: 100%;
    justify-content: center;
    padding: 1rem;
    font-size: .975rem;
    margin-top: .25rem;
  }

  .form-error {
    font-size: .85rem;
    color: #f87171;
    min-height: 1.2em;
  }

  /* Success state */
  .form-success {
    text-align: center;
    padding: 2rem 1rem;
  }

  .success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(34,197,94,.15);
    color: #22c55e;
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .form-success h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--dark);
    margin-bottom: .5rem;
  }

  .form-success p {
    color: var(--grey);
    font-size: .9rem;
  }

  /* Responsive */
  @media (max-width: 860px) {
    .contact-inner { grid-template-columns: 1fr; gap: 3rem; }
    .contact-sub   { max-width: 100%; }
  }
  @media (max-width: 480px) {
    .form-row  { grid-template-columns: 1fr; }
    .form-card { padding: 1.5rem; }
  }
</style>

<script>
  const form      = document.getElementById('contactForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn')  as HTMLButtonElement;
  const errorBox  = document.getElementById('formError')  as HTMLDivElement;
  const successEl = document.getElementById('formSuccess') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.textContent = '';
    submitBtn.disabled   = true;
    submitBtn.textContent = 'Envoi en cours…';

    try {
      const res  = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const json = await res.json();

      if (json.ok) {
        form.hidden      = true;
        successEl.hidden = false;
      } else {
        errorBox.textContent  = json.error || 'Une erreur est survenue, veuillez réessayer.';
        submitBtn.disabled    = false;
        submitBtn.textContent = 'Envoyer ma demande →';
      }
    } catch {
      errorBox.textContent  = 'Impossible d\'envoyer le message. Vérifiez votre connexion.';
      submitBtn.disabled    = false;
      submitBtn.textContent = 'Envoyer ma demande →';
    }
  });
</script>
